global:
  scrape_interval: {{ exporters_scrape_interval }}s
  external_labels:
    monitor: 'example'

# Metrics are received via remote write from vmagent instances on each host.
# Only blackbox HTTP probes are scraped locally.
scrape_configs:
  - job_name: blackbox
    authorization:
      type: Bearer
      credentials_file: '/etc/victoriametrics/exporters_auth_password'
    scrape_interval: {{ exporters_blackbox_http_check_interval }}s
    scrape_timeout: {{ exporters_blackbox_http_check_interval - 1 }}s
    metrics_path: /proxy
    params:
      module:
        - blackbox
        - http
    file_sd_configs:
      - files:
        - "/etc/prometheus/blackbox-exporter/*.yml"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:9999
