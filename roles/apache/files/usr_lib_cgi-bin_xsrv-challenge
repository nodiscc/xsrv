#!/usr/bin/env python3
"""xsrv-challenge — SHA-256 Proof-of-Work challenge CGI script.

Two modes:
  GET  → generates challenge, redirects to /challenge.html
  POST → verifies nonce, sets cookie, redirects to original URL
"""

import hashlib
import hmac
import os
import sys
import urllib.parse

try:
    DIFFICULTY = int(os.environ.get("XSRV_CHALLENGE_DIFFICULTY", "1"))
except ValueError:
    DIFFICULTY = 1
COOKIE_NAME = "xsrv_challenge_accepted"
CHALLENGE_COOKIE = "pow_challenge"
COOKIE_MAX_AGE = 1800  # 30 minutes
CHALLENGE_LENGTH = 16  # 16 random bytes → 32 hex chars
SECRET = os.environ.get("XSRV_CHALLENGE_SECRET", "")
MAX_BODY = 4096  # 4KB max POST body


def sign_cookie(challenge_hex, nonce_str):
    """Create HMAC-signed cookie value."""
    payload = f"{challenge_hex}:{nonce_str}"
    signature = hmac.new(SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()
    return f"{payload}:{signature}"


def validate_redirect(redirect_url, host):
    """Validate redirect target is on the same host."""
    if not redirect_url or not redirect_url.startswith("/"):
        return False
    parsed = urllib.parse.urlparse(redirect_url)
    if parsed.hostname and parsed.hostname != host:
        return False
    # Only allow http/https relative URLs
    if parsed.scheme and parsed.scheme not in ("http", "https"):
        return False
    return True


def verify_pow(challenge_hex, nonce_str, difficulty):
    """Verify SHA-256(challenge;nonce) has `difficulty` leading zero bytes."""
    try:
        nonce = int(nonce_str)
    except ValueError:
        return False
    msg = f"{challenge_hex};{nonce}"
    h = hashlib.sha256(msg.encode("utf-8")).digest()
    for i in range(difficulty):
        if h[i] != 0:
            return False
    return True


def handle_get(host, query_string):
    """Generate challenge and redirect to static HTML page."""
    params = urllib.parse.parse_qs(query_string)
    redirect_url = params.get("redirect", ["/"])[0].replace("\r", "").replace("\n", "")

    if not validate_redirect(redirect_url, host):
        print("Status: 400 Bad Request")
        print("Content-Type: text/html")
        print()
        print("<html><body>Invalid redirect URL.</body></html>")
        sys.stdout.flush()
        return

    challenge = os.urandom(CHALLENGE_LENGTH).hex()
    encoded_redirect = urllib.parse.quote(redirect_url, safe="")

    print(f"Set-Cookie: {CHALLENGE_COOKIE}={challenge}; path=/; max-age={COOKIE_MAX_AGE}; SameSite=Lax; domain={host}")
    print(f"Set-Cookie: {COOKIE_NAME}=deleted; path=/; max-age=0; SameSite=Lax; domain={host}")
    print(f"Location: /challenge.html?challenge={challenge}&diff={DIFFICULTY}&redirect={encoded_redirect}")
    print("Content-Length: 0")
    print()
    sys.stdout.flush()


def handle_post(host, body):
    """Verify PoW solution and set cookie."""
    params = urllib.parse.parse_qs(body)
    challenge = params.get("challenge", [None])[0]
    nonce = params.get("nonce", [None])[0]
    redirect_url = params.get("redirect", ["/"])[0].replace("\r", "").replace("\n", "")

    if not challenge or not nonce or not validate_redirect(redirect_url, host):
        print("Status: 400 Bad Request")
        print("Content-Type: text/html")
        print()
        print("<html><body>Invalid challenge. Please try again.</body></html>")
        sys.stdout.flush()
        return

    if not verify_pow(challenge, nonce, DIFFICULTY):
        encoded_challenge = urllib.parse.quote(challenge, safe="")
        print(f"Location: /challenge.html?challenge={encoded_challenge}&diff={DIFFICULTY}")
        print("Content-Length: 0")
        print()
        sys.stdout.flush()
        return

    cookie_value = sign_cookie(challenge, nonce)
    print(f"Set-Cookie: {COOKIE_NAME}={cookie_value}; path=/; max-age={COOKIE_MAX_AGE}; SameSite=Lax; domain={host}")
    print(f"Location: {redirect_url}")
    print("Content-Length: 0")
    print()
    sys.stdout.flush()


def main():
    content_type = os.environ.get("CONTENT_TYPE", "")
    if content_type == "application/x-www-form-urlencoded" or os.environ.get("REQUEST_METHOD") == "POST":
        try:
            content_length = min(int(os.environ.get("CONTENT_LENGTH", 0)), MAX_BODY)
        except ValueError:
            content_length = 0
        body = sys.stdin.read(content_length) if content_length > 0 else ""
        handle_post(os.environ.get("HTTP_HOST", "").replace("\r", "").replace("\n", ""), body)
    else:
        handle_get(os.environ.get("HTTP_HOST", "").replace("\r", "").replace("\n", ""), os.environ.get("QUERY_STRING", ""))


if __name__ == "__main__":
    main()
