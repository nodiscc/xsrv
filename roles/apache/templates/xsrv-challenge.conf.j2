# xsrv JavaScript PoW challenge configuration
SetEnv XSRV_CHALLENGE_DIFFICULTY {{ apache_javascript_challenge_difficulty }}
SetEnv XSRV_CHALLENGE_SECRET {{ apache_javascript_challenge_secret }}
ScriptAlias /cgi-bin/xsrv-challenge /usr/lib/cgi-bin/xsrv-challenge
ScriptAlias /cgi-bin/ /usr/lib/cgi-bin/
Alias /challenge.html /var/www/challenge.html
<Directory /usr/lib/cgi-bin>
  Options +ExecCGI
</Directory>
# Serve challenge assets without gate
RewriteEngine On
RewriteCond %{REQUEST_URI} ^/challenge\.html$ [NC,OR]
RewriteCond %{REQUEST_URI} ^/cgi-bin/xsrv-challenge$ [NC]
RewriteRule ^.*$ - [L]
# Challenge if no valid cookie
RewriteCond %{HTTP_COOKIE} !xsrv_challenge_accepted=. [NC]
RewriteRule ^(.*)$ /cgi-bin/xsrv-challenge?redirect=%{REQUEST_URI} [R=302,L]
